# GEMINI_API_KEY: Required for Gemma / GenAI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMMA_MODEL: Primary open-weight Gemma model (configurable)
GEMMA_MODEL="gemma-3-27b-it"

# MONGODB_URI: MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/studymate_ai"

# JWT_SECRET: Secret key for signing authentication tokens
JWT_SECRET="studymate_jwt_secret_key_change_in_prod"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
